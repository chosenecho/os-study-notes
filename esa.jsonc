{
  "name": "os-study-notes",
  "description": "操作系统概论学习笔记",
  "installCommand": "npx --yes --package=node@24.16.0 --call \"npm --prefix 笔记网站 ci --no-audit --no-fund\"",
  "buildCommand": "npx --yes --package=node@24.16.0 --call \"npm --prefix 笔记网站 run build\"",
  "assets": {
    "directory": "./笔记网站/dist",
    "notFoundStrategy": "404Page"
  }
}
