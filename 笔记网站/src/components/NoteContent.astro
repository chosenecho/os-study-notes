---
import MarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
const chapter = Astro.url.pathname.match(/chapter-(\d)/)?.[1];
---
{chapter && <div class="study-toolbar" data-chapter={chapter}>
  <label><input type="checkbox" data-complete /> 本章已复习</label>
  <label class="reading-size">字号<select data-reading-size aria-label="正文字号"><option value="16">标准</option><option value="18">较大</option><option value="20">大号</option></select></label>
  <span class="save-status" role="status"></span>
</div>}
<MarkdownContent><slot /></MarkdownContent>
<dialog class="image-dialog" aria-label="插图预览">
  <button type="button" class="close-dialog" autofocus>关闭 · Esc</button>
  <img alt="" />
  <p></p>
</dialog>
<script>
  import { initNotes } from '../scripts/notes';
  initNotes();
  document.addEventListener('astro:page-load', initNotes);
</script>
