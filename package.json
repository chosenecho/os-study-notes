{
  "name": "studynote",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chosenecho/studynote.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "python -m mkdocs serve",
    "build": "python -m mkdocs build --strict",
    "deploy": "node tools/deploy/ecs.mjs",
    "esa:configure": "node tools/deploy/esa.mjs",
    "check:structure": "python -X utf8 tools/checks/structure.py",
    "check:rights": "python -X utf8 tools/checks/rights.py",
    "check:notes": "python -X utf8 tools/checks/notes.py",
    "check:revisions": "python -X utf8 tools/checks/revisions.py",
    "check:links": "node tools/checks/links.mjs",
    "test:unit": "python -X utf8 -m unittest discover -s tests/unit -p test_*.py && node tests/unit/scheduling.test.mjs && node tests/unit/labs.test.mjs",
    "test:browser": "node tests/browser/labs.test.mjs",
    "test": "npm run test:unit",
    "check": "npm run check:rights && npm run check:structure && npm run check:notes && npm run check:revisions && npm run test:unit && npm run build && npm run check:links"
  },
  "devDependencies": {
    "esa-cli": "1.0.13",
    "playwright": "1.60.0"
  }
}
